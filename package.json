{
  "name": "astral-surveyor-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run i18n:generate && tsc -b && vite build && node scripts/generate-service-worker.mjs",
    "lint": "oxlint",
    "test": "vitest run --exclude src/data/progressiveCatalogScale.test.ts",
    "check": "npm run lint && npm run test && npm run catalog:benchmark && npm run i18n:check && npm run build",
    "i18n:check": "node scripts/generate-i18n-packs.mjs --check",
    "i18n:generate": "node scripts/generate-i18n-packs.mjs",
    "catalog:refresh": "node scripts/refresh-progressive-exoplanet-catalog.mjs",
    "catalog:benchmark": "vitest run src/data/progressiveCatalogScale.test.ts --reporter=verbose --maxWorkers=1",
    "preview": "vite preview"
  },
  "dependencies": {
    "i18next": "^26.3.6",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "simplex-noise": "^4.0.3",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
